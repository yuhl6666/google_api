# Copy to .env to customize docker-compose. Everything here has a working
# default in docker-compose.yml, so an empty/missing .env is fine too.

POSTGRES_USER=light_one
POSTGRES_PASSWORD=light_one
POSTGRES_DB=light_one

# Overrides the Model Registry's ses-classifier.runtime.model, for quickly
# trying a different Ollama model without editing llm/src/registry/models.json.
SES_CLASSIFIER_MODEL=llama3.1:8b
