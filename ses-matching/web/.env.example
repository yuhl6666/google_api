# Firebase Consoleの「プロジェクトの設定」>「全般」>「マイアプリ」から取得
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-app-id

# Cloud FunctionsのAPI呼び出し先。
# Firebase Hostingにデプロイした場合は /api のままでrewrite経由で届く。
# ローカルでエミュレータを使う場合はエミュレータのURLに変更する:
# VITE_API_BASE_URL=http://127.0.0.1:5001/<project-id>/asia-northeast1/api
VITE_API_BASE_URL=/api

# ローカル開発でAuthエミュレータを使う場合は true にする
VITE_USE_AUTH_EMULATOR=false
