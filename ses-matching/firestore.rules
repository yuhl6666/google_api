rules_version = '2';

// このアプリはフロントエンドから直接Firestoreへアクセスせず、
// 認証済みユーザーのIDトークンをCloud Functions(API)経由で検証してから
// Admin SDKで読み書きする構成のため、クライアントSDKからの直接アクセスは
// 全面的に拒否する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
